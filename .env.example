# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values to your local PostgreSQL setup.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campus_events
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus

# Optional: overrides all POSTGRES_* variables above if set.
# DATABASE_URL=postgresql+psycopg2://campus:campus@localhost:5432/campus_events

# Application
APP_HOST=127.0.0.1
APP_PORT=8000

# Comma separated list of origins allowed to call the API from a browser.
# "*" is fine for local development.
CORS_ORIGINS=*

# Data files used by the seeding script
EVENTS_CSV=data/raw/campus_events_skopje.csv
STUDENTS_CSV=data/students.csv

# Seed for the synthetic student generator (keeps the dataset reproducible)
RANDOM_SEED=42
